[Unit]
Description=LoRa campus monitor - LoRa receiver and data logger
Documentation=file:///opt/lora-campus-monitor/README.md
# Needs only local storage: keeps receiving and storing without Wi-Fi/Ethernet.
After=local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=loramon
Group=loramon
SupplementaryGroups=spi gpio
WorkingDirectory=/opt/lora-campus-monitor/raspberry-pi
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/lora-campus-monitor/raspberry-pi/.venv/bin/python -m app.receiver
Restart=always
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/lora-campus-monitor/raspberry-pi/database /opt/lora-campus-monitor/raspberry-pi/logs

[Install]
WantedBy=multi-user.target
