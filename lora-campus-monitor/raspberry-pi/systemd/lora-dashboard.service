[Unit]
Description=LoRa campus monitor - web dashboard
After=network.target local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=loramon
Group=loramon
WorkingDirectory=/opt/lora-campus-monitor/raspberry-pi
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/lora-campus-monitor/raspberry-pi/.venv/bin/python -m app.serve
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/lora-campus-monitor/raspberry-pi/database /opt/lora-campus-monitor/raspberry-pi/logs

[Install]
WantedBy=multi-user.target
